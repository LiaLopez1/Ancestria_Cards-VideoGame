      m_Items: []
  - m_Id: 18188643958562816
    m_Localized: Selecciona la carta que quieres intercambiar.
    m_Metadata:
      m_Items: []
  - m_Id: 18188645854388224
    m_Localized: "{0} quiere intercambiar una carta contigo. \xBFAceptas?"
    m_Metadata:
      m_Items: []
  - m_Id: 18188646928130048
    m_Localized: Esperando al otro jugador...
    m_Metadata:
      m_Items: []
  - m_Id: 18188647628578816
    m_Localized: "El otro jugador no acept\xF3 el intercambio."
    m_Metadata:
      m_Items: []
  - m_Id: 18188648438079488
    m_Localized: Confirmando el intercambio...
    m_Metadata:
      m_Items: []
  - m_Id: 18188649344049152
    m_Localized: La leyenda ha triunfado...
    m_Metadata:
      m_Items: []
  - m_Id: 18188650279378944
    m_Localized: Volver al inicio
    m_Metadata:
      m_Items: []
  - m_Id: 18188651181154304
